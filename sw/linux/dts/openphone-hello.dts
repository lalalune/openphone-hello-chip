/*
 * Minimal OpenPhone hello device tree source.
 *
 * This is a source artifact for an external Linux tree. It exposes the MMIO
 * contract from sw/platform/hello_platform_contract.json; it does not claim
 * that an upstream kernel platform or full SoC CPU integration exists.
 *
 * This file is not a standalone AP boot DTB. The selected generated AP target
 * must provide CPU, memory, timer, interrupt-controller, and enabled UART
 * console nodes before OpenSBI or Linux boot evidence can pass.
 */

/dts-v1/;

/ {
	compatible = "openphone,hello-board", "openphone,hello";
	model = "OpenPhone hello software BSP";
	#address-cells = <2>;
	#size-cells = <2>;

	chosen {
		bootargs = "console=ttyS0 earlycon";
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		status = "disabled";
		/*
		 * Stub for a Murata Type 1DX / CYW4343W-class external module.
		 * Bind WIFI_EN/WIFI_RST_N to real GPIO phandles after hello-chip
		 * grows a GPIO/pinctrl-backed SDIO host integration.
		 */
		post-power-on-delay-ms = <200>;
		/* reset-gpios = <&gpioX N GPIO_ACTIVE_LOW>; required before enable. */
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		hello_dma: dma@10010000 {
			compatible = "openphone,hello-dma";
			reg = <0x0 0x10010000 0x0 0x1000>;
			interrupt-names = "IRQ_DMA";
			/* HELLO_DMA_BASE */
		};

		hello_npu: npu@10020000 {
			compatible = "openphone,hello-npu";
			reg = <0x0 0x10020000 0x0 0x1000>;
			interrupt-names = "IRQ_NPU";
			/* HELLO_NPU_BASE */
		};

		hello_display: display@10030000 {
			compatible = "openphone,hello-display";
			reg = <0x0 0x10030000 0x0 0x1000>;
			interrupt-names = "IRQ_VSYNC";
			/* HELLO_DISPLAY_BASE */
		};

		sdio0: mmc@10050000 {
			compatible = "openphone,hello-sdio-host";
			status = "disabled";
			reg = <0x0 0x10050000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			bus-width = <4>;
			non-removable;
			cap-sd-highspeed;
			mmc-pwrseq = <&wifi_pwrseq>;
			/*
			 * WIFI_SDIO_CLK/CMD/D0/D1/D2/D3: RTL host, pinctrl,
			 * regulators, clocks, and GPIO-backed power sequencing are
			 * not implemented. Keep disabled until real phandles exist.
			 */

			wifi@1 {
				compatible = "brcm,bcm4329-fmac";
				reg = <1>;
				interrupt-names = "host-wake";
				/* WIFI_IRQ/WIFI_HOST_WAKE: bind to real interrupt GPIO later. */
			};
		};

		uart1: serial@10051000 {
			compatible = "openphone,hello-uart";
			status = "disabled";
			reg = <0x0 0x10051000 0x0 0x1000>;
			/*
			 * BT_UART_TX/RX/CTS_N/RTS_N: RTL UART and flow-control
			 * pinctrl are not implemented.
			 */

			bluetooth {
				compatible = "brcm,bcm43438-bt";
				max-speed = <3000000>;
				shutdown-gpios = <0>;
				device-wakeup-gpios = <0>;
				host-wakeup-gpios = <0>;
			};
		};
	};
};
