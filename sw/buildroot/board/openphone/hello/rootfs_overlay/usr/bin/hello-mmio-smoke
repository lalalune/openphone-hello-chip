#!/bin/sh
# Source-level smoke hook for the OpenPhone hello Buildroot rootfs.
#
# Real MMIO access requires a kernel built with sw/linux/dts/openphone-hello.dts
# and the hello drivers from sw/linux/drivers/hello. This script records the
# platform contract values expected by the user-space probe.

set -eu

CONTRACT=/etc/openphone/hello_platform_contract.json

echo "OpenPhone hello MMIO smoke"
echo "contract=${CONTRACT}"
echo "HELLO_NPU_BASE=0x10020000"
echo "HELLO_DMA_BASE=0x10010000"
echo "HELLO_DISPLAY_BASE=0x10030000"

if [ ! -e /dev/hello-npu ]; then
    echo "missing /dev/hello-npu; import sw/linux drivers into the external kernel tree" >&2
    exit 2
fi

echo "hello BSP device nodes present"
