# Minimal Buildroot defconfig for the OpenPhone hello software BSP.
#
# This file is meant to be copied into an external Buildroot tree as:
#   configs/openphone_hello_defconfig
#
# It is not a checked-in Buildroot release. The checked-in source contract is
# sw/platform/hello_platform_contract.json, with generated constants such as
# HELLO_NPU_BASE, HELLO_DMA_BASE, and HELLO_DISPLAY_BASE.
BR2_riscv=y
BR2_RISCV_64=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ABI_LP64D=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="openphone-hello"
BR2_TARGET_GENERIC_ISSUE="OpenPhone hello BSP"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENPHONE_HELLO_PATH)/board/openphone/hello/rootfs_overlay"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(BR2_EXTERNAL_OPENPHONE_HELLO_PATH)/../linux-external.tar.xz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_OPENPHONE_HELLO_PATH)/board/openphone/hello/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="openphone-hello"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_PACKAGE_OPENPHONE_HELLO_BSP=y
BR2_PACKAGE_HELLO_MMIO_SMOKE=y
BR2_PACKAGE_HELLO_NPU_ML_SMOKE=y
