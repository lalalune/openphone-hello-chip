// HIDL interface v0 for the hello_npu HAL.
//
// Backing contract: sw/platform/hello_platform_contract.json
// Status: stub. Only one RPC is defined: a fixed-vector smoke that returns
// the device-side identity word produced by the openphone-hello kernel
// driver. No model load, no inference, no DMA, no power state.
//
// Build placement (external AOSP tree):
//   hardware/interfaces/openphone/hello_npu/1.0/IHelloNpu.hal
// then regenerate vendor.openphone.hello_npu@1.0 with hidl-gen.

package vendor.openphone.hello_npu@1.0;

enum Status : uint32_t {
    OK = 0,
    NOT_SUPPORTED = 1,
    IO_ERROR = 2,
};

interface IHelloNpu {
    /**
     * Fixed-vector smoke RPC.
     *
     * Returns the 32-bit identity word read from HELLO_NPU_RESULT_OFFSET
     * of the backing /dev/hello-npu node. The HAL service MUST return
     * status NOT_SUPPORTED when the node is absent or open() fails.
     *
     * @return status    OK on success, NOT_SUPPORTED on missing node,
     *                   IO_ERROR on any other failure.
     * @return identity  Driver-reported identity word; meaningful only
     *                   when status == OK.
     */
    smoke() generates (Status status, uint32_t identity);
};
