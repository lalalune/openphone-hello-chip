# Android kernel fragment for the openphone_ai_soc scaffold.
# Keep this aligned with sw/platform/hello_platform_contract.json.

CONFIG_RISCV=y
CONFIG_64BIT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_DM_VERITY=y
CONFIG_DM_INIT=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_DRM=y
CONFIG_FB=y
