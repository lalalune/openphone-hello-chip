# SELinux policy v0 for the hello_npu HAL.
#
# Goals:
#   - Define a dedicated dev_type for /dev/hello-npu so the kernel char-dev
#     and the HAL binary are the only things that touch it.
#   - Define a HAL domain hal_hello_npu_default with the absolute minimum
#     allow set required to open the char device, serve HwBinder, and log.
#   - Do NOT grant any rule that would trip an AOSP neverallow:
#       * no untrusted_app/isolated_app access to the device.
#       * no allow on system_app to vendor binders.
#       * no execmem/execstack, no /dev/mem, no kernel_t writes.
#       * no domain_trans into init/shell/vendor_shell.

type hello_npu_device, dev_type;

type hal_hello_npu_default, domain;
type hal_hello_npu_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_hello_npu_default)
hal_server_domain(hal_hello_npu_default, hal_hello_npu)

# Allow the HAL to open and ioctl the kernel device. Read/write only; no
# create/unlink/relabel.
allow hal_hello_npu_default hello_npu_device:chr_file { open read write ioctl getattr };

# Vendor scratch directory created by init.openphone.rc.
type hello_npu_data_file, file_type, data_file_type, core_data_file_type;
allow hal_hello_npu_default hello_npu_data_file:dir { search read open };
allow hal_hello_npu_default hello_npu_data_file:file { open read write create getattr };

# Property gating: HAL reads vendor.hello_npu.ready (declared via
# property_contexts in a future change). Until that context is added, the
# HAL falls back to a default-deny read which is safe.
