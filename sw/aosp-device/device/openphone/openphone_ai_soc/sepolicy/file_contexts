# SELinux file contexts for the external AOSP openphone_ai_soc device tree.
# The hello_npu HAL is a fail-closed integration point tied to
# sw/platform/hello_platform_contract.json.

/vendor/bin/hw/hello_npu\.default        u:object_r:hal_hello_npu_default_exec:s0
/vendor/bin/hw/hwcomposer\.openphone_ai_soc u:object_r:hal_graphics_composer_default_exec:s0
/dev/hello-npu                          u:object_r:hello_npu_device:s0
