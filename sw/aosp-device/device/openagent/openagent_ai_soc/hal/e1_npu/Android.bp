// hello_npu HAL v0 - fail-closed stub for vendor.openphone.hello_npu@1.0.
//
// Backing contract: sw/platform/hello_platform_contract.json
// Backing kernel node: /dev/hello-npu (drivers/misc/openphone-hello).
//
// Status: stub. Service binary opens /dev/hello-npu read/write and exposes
// a single fixed-vector smoke RPC. Returns UNSUPPORTED when the device
// node is absent. No model loading, no DMA, no scheduler, no power.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "vendor.openphone.hello_npu@1.0-service",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["vendor.openphone.hello_npu@1.0-service.rc"],
    vintf_fragments: ["vendor.openphone.hello_npu@1.0-service.xml"],

    srcs: [
        "service.cpp",
        "HelloNpu.cpp",
    ],

    shared_libs: [
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
        "vendor.openphone.hello_npu@1.0",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
}
