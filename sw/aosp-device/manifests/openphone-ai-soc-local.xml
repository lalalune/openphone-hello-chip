    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/sepolicy/file_contexts"
              dest="device/openphone/openphone_ai_soc/sepolicy/file_contexts" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/sepolicy/hello_npu.te"
              dest="device/openphone/openphone_ai_soc/sepolicy/hello_npu.te" />
