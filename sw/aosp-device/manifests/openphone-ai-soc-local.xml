           remote="openphone-local"
           revision="HEAD">
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/AndroidProducts.mk"
              dest="device/openphone/openphone_ai_soc/AndroidProducts.mk" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/BoardConfig.mk"
              dest="device/openphone/openphone_ai_soc/BoardConfig.mk" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/device.mk"
              dest="device/openphone/openphone_ai_soc/device.mk" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/openphone_ai_soc.mk"
              dest="device/openphone/openphone_ai_soc/openphone_ai_soc.mk" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/init.openphone.rc"
              dest="device/openphone/openphone_ai_soc/init.openphone.rc" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/fstab.openphone"
              dest="device/openphone/openphone_ai_soc/fstab.openphone" />
    <linkfile src="sw/aosp-device/device/openphone/openphone_ai_soc/manifest.xml"
