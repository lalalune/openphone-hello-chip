{
  "version": "0.1",
  "benchmarks": [
    {
      "name": "coremark",
      "suite": "CoreMark",
      "version": "upstream/local",
      "command": ["coremark"],
      "requires": ["coremark"],
      "install": "Build EEMBC CoreMark for the target and place the real coremark executable on PATH, or run scripts/install_coremark_stream_tools.sh --coremark-src <upstream-coremark> --only coremark to install it into tools/bin.",
      "input_dataset": "default",
      "primary_metric": "CoreMark/MHz",
      "units": "score_per_mhz",
      "timeout_seconds": 300
    },
    {
      "name": "stream",
      "suite": "STREAM",
      "version": "upstream/local",
      "command": ["stream_c.exe"],
      "requires": ["stream_c.exe"],
      "install": "Compile STREAM from source for the target compiler, keep the executable named stream_c.exe, and place it on PATH, or run scripts/install_coremark_stream_tools.sh --stream-src <upstream-stream> --only stream to install it into tools/bin.",
      "input_dataset": "default arrays",
      "primary_metric": "Triad bandwidth",
      "units": "MB/s",
      "timeout_seconds": 300
    },
    {
      "name": "lmbench_bw_mem",
      "suite": "lmbench",
      "version": "upstream/local",
      "command": ["bw_mem", "64M", "rd"],
      "requires": ["bw_mem"],
      "install": "Build lmbench for the target and place bw_mem on PATH. For local CLI wiring, scripts/install_benchmark_smoke_tools.sh --lmbench-bin-dir <lmbench-bin-dir> can link a real built executable into .venv/bin; repo-local smoke shims are rejected for strict release claims.",
      "input_dataset": "64M read",
      "primary_metric": "memory bandwidth",
      "units": "MB/s",
      "timeout_seconds": 300
    },
    {
      "name": "lmbench_lat_mem_rd",
      "suite": "lmbench",
      "version": "upstream/local",
      "command": ["lat_mem_rd", "64M", "128"],
      "requires": ["lat_mem_rd"],
      "install": "Build lmbench for the target and place lat_mem_rd on PATH. For local CLI wiring, scripts/install_benchmark_smoke_tools.sh --lmbench-bin-dir <lmbench-bin-dir> can link a real built executable into .venv/bin; repo-local smoke shims are rejected for strict release claims.",
      "input_dataset": "64M stride sweep",
      "primary_metric": "memory latency",
      "units": "ns",
      "timeout_seconds": 300
    },
    {
      "name": "fio_seq_read",
      "suite": "fio",
      "version": "upstream/local",
      "command": ["fio", "--output-format=json", "benchmarks/configs/fio-seq-read.fio"],
      "requires": ["fio"],
      "install": "Install fio from the target OS package manager or build it for the target and place fio on PATH.",
      "input_dataset": "128MiB sequential read file",
      "primary_metric": "read bandwidth",
      "units": "KiB/s",
      "timeout_seconds": 600
    },
    {
      "name": "fio_rand_rw",
      "suite": "fio",
      "version": "upstream/local",
      "command": ["fio", "--output-format=json", "benchmarks/configs/fio-rand-rw.fio"],
      "requires": ["fio"],
      "install": "Install fio from the target OS package manager or build it for the target and place fio on PATH.",
      "input_dataset": "128MiB 4KiB random read/write file",
      "primary_metric": "IOPS",
      "units": "iops",
      "timeout_seconds": 600
    },
    {
      "name": "npu_arch_sim_open_2028",
      "suite": "OpenPhone deterministic NPU architecture simulator",
      "version": "local/open-scale-v1",
      "command": [
        "python3",
        "benchmarks/sim/run_npu_scale_sim.py",
        "--config",
        "open_2028_first_50tops"
      ],
      "requires": ["python3"],
      "input_dataset": "deterministic GEMM/conv/attention sweep",
      "primary_metric": "modeled dense INT8 TOPS",
      "units": "TOPS",
      "timeout_seconds": 60
    },
    {
      "name": "tflite_cpu",
      "suite": "TensorFlow Lite benchmark_model",
      "version": "upstream/local",
      "command": [
        "benchmark_model",
        "--graph=benchmarks/models/mobile_smoke.tflite",
        "--num_threads=1",
        "--use_nnapi=false"
      ],
      "requires": ["benchmark_model"],
      "model_artifacts": [
        {
          "path": "benchmarks/models/mobile_smoke.tflite",
          "placeholder_allowed": false,
          "min_size_bytes": 4096,
          "blocker_id": "TFLITE_SMOKE_MODEL_MISSING",
          "pipeline_visible": true,
          "release_blocking": true,
          "resolution": "Run benchmarks/models/generate_mobile_smoke_tflite.py in an environment with TensorFlow installed, or supply a redistributable TFLite model and pin sha256.",
          "generator": {
            "command": [
              "python3",
              "benchmarks/models/generate_mobile_smoke_tflite.py",
              "--out",
              "benchmarks/models/mobile_smoke.tflite"
            ],
            "network": "none",
            "deterministic": true
          }
        }
      ],
      "install": "Build TensorFlow Lite benchmark_model for the target and generate or supply a non-proprietary smoke .tflite model at benchmarks/models/mobile_smoke.tflite.",
      "input_dataset": "mobile_smoke.tflite synthetic input",
      "primary_metric": "inference latency",
      "units": "us",
      "timeout_seconds": 600
    },
    {
      "name": "tflite_hello_npu",
      "suite": "TensorFlow Lite benchmark_model",
      "version": "upstream/local",
      "command": [
        "benchmark_model",
        "--graph=benchmarks/models/mobile_smoke.tflite",
        "--use_nnapi=true",
        "--nnapi_accelerator_name=hello-npu"
      ],
      "requires": ["benchmark_model"],
      "capability_artifacts": [
        {
          "path": "benchmarks/capabilities/hello_npu_nnapi.proof.json",
          "blocker_id": "HELLO_NPU_NNAPI_ACCELERATOR_MISSING",
          "blocked_reason": "missing_hello_npu_nnapi_accelerator",
          "pipeline_visible": true,
          "release_blocking": true,
          "resolution": "Run this benchmark only on an Android/Linux target exposing a real hello-npu NNAPI accelerator or delegate; create the proof JSON and transcripts from the hardware validation job, not by hand.",
          "proof": {
            "schema": "openphone.hello_npu_nnapi_capability.v1",
            "accelerator_name": "hello-npu",
            "max_cpu_fallback_percent": 0,
            "max_unsupported_op_count": 0,
            "required_json_fields": [
              "capability.claim_level",
              "capability.precision",
              "dataflow.name",
              "dma.path",
              "dma.bytes_read",
              "dma.bytes_written",
              "measurements.macs_per_inference",
              "measurements.npu_cycles",
              "measurements.npu_hz",
              "measurements.observed_tops",
              "measurements.tops_formula"
            ],
            "required_model_artifacts": [
              "benchmarks/models/mobile_smoke.tflite"
            ],
            "required_files": [
              "adb_devices",
              "nnapi_accelerator_query",
              "benchmark_model_nnapi",
              "dma_trace"
            ],
            "required_transcript_markers": {
              "adb_devices": ["device"],
              "nnapi_accelerator_query": ["hello-npu"],
              "benchmark_model_nnapi": [
                "--use_nnapi=true",
                "--nnapi_accelerator_name=hello-npu",
                "NNAPI"
              ],
              "dma_trace": ["hello-npu", "DMA", "bytes_read", "bytes_written"]
            }
          }
        }
      ],
      "model_artifacts": [
        {
          "path": "benchmarks/models/mobile_smoke.tflite",
          "placeholder_allowed": false,
          "min_size_bytes": 4096,
          "blocker_id": "TFLITE_SMOKE_MODEL_MISSING",
          "pipeline_visible": true,
          "release_blocking": true,
          "resolution": "Run benchmarks/models/generate_mobile_smoke_tflite.py in an environment with TensorFlow installed, or supply a redistributable TFLite model and pin sha256.",
          "generator": {
            "command": [
              "python3",
              "benchmarks/models/generate_mobile_smoke_tflite.py",
              "--out",
              "benchmarks/models/mobile_smoke.tflite"
            ],
            "network": "none",
            "deterministic": true
          }
        }
      ],
      "install": "Build TensorFlow Lite benchmark_model with NNAPI support and generate or supply a non-proprietary smoke .tflite model at benchmarks/models/mobile_smoke.tflite.",
      "input_dataset": "mobile_smoke.tflite synthetic input",
      "primary_metric": "inference latency",
      "units": "us",
      "timeout_seconds": 600
    }
  ]
}
