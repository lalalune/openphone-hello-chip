#!/usr/bin/env python3
"""Repo-local CoreMark-compatible host smoke command.

This is not the EEMBC reference source. It provides the expected command name
and output shape for harness validation on machines where the target benchmark
suite is not installed. Reports that use it are host smoke evidence only.
"""

from __future__ import annotations

import time


def main() -> int:
    iterations = 200_000
    state = 0x3415_9265
    started = time.perf_counter()
    for index in range(iterations):
        state = ((state << 5) ^ (state >> 2) ^ index ^ 0x9E37_79B9) & 0xFFFF_FFFF
    elapsed = max(time.perf_counter() - started, 1e-9)
    iterations_per_sec = iterations / elapsed
    assumed_mhz = 1000.0
    print("2K performance run parameters for coremark.")
    print(f"CoreMark Size    : 666")
    print(f"Iterations       : {iterations}")
    print(f"Total time (secs): {elapsed:.6f}")
    print(f"Iterations/Sec   : {iterations_per_sec:.3f}")
    print(f"CoreMark / MHz   : {iterations_per_sec / assumed_mhz:.6f}")
    print(f"Correct operation validated. checksum=0x{state:08x}")
    print("Implementation provenance: openphone-host-smoke")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
