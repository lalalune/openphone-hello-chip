[files]
rtl/bootrom/hello_bootrom.sv
rtl/peripherals/hello_peripherals.sv
rtl/dma/hello_dma.sv
rtl/npu/hello_npu.sv
rtl/display/hello_display.sv
rtl/top/hello_soc_top.sv
verify/formal/hello_soc_top_formal.sv
