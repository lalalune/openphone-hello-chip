(kicad_pcb
  (version 20231120)
  (generator "pcbnew")
  (generator_version "7.0")

  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )

  (paper "A3")
  (title_block
    (title "Hello Demo Evaluation Board")
    (date "2026-05-17")
    (rev "v0.1")
    (company "OpenPhone")
    (comment 1 "100mm x 80mm 4-layer FR4")
    (comment 2 "RISC-V SoC evaluation board")
    (comment 3 "hello_chip_top.sv: JTAG, UART, GPIO, CLK_24M, nRST")
    (comment 4 "NOT FOR FABRICATION - ERC/DRC must pass first")
  )

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" power "GND reference plane")
    (2 "In2.Cu" power "PWR split: VDDCORE + VDD_3V3 + VDD_1V8")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotfptext yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "VIN_5V")
  (net 3 "VDD_CORE")
  (net 4 "VDD_3V3")
  (net 5 "VDD_1V8")
  (net 6 "CLK_24M")
  (net 7 "nRST")
  (net 8 "JTAG_TCK")
  (net 9 "JTAG_TMS")
  (net 10 "JTAG_TDI")
  (net 11 "JTAG_TDO")
  (net 12 "UART_TX")
  (net 13 "UART_RX")
  (net 14 "GPIO0")
  (net 15 "GPIO1")
  (net 16 "GPIO2")
  (net 17 "GPIO3")
  (net 18 "IRQ_TIMER")
  (net 19 "IRQ_DMA")
  (net 20 "BOOT_SEL")
  (net 21 "SW_BUCK")
  (net 22 "FB_BUCK")
  (net 23 "VBUS_RAW")

  ;; ============================================================
  ;; STACKUP definition
  ;; ============================================================
  (stackup
    (layer "F.SilkS"
      (type "Top Silk Screen")
    )
    (layer "F.Paste"
      (type "Top Solder Paste")
    )
    (layer "F.Mask"
      (type "Top Solder Mask")
      (thickness 0.01)
    )
    (layer "F.Cu"
      (type "copper")
      (thickness 0.035)
    )
    (layer "dielectric 1"
      (type "prepreg")
      (thickness 0.2)
      (material "Isola 370HR")
      (epsilon_r 4.2)
      (loss_tangent 0.02)
    )
    (layer "In1.Cu"
      (type "copper")
      (thickness 0.0175)
    )
    (layer "dielectric 2"
      (type "core")
      (thickness 0.6)
      (material "FR4")
      (epsilon_r 4.5)
      (loss_tangent 0.02)
    )
    (layer "In2.Cu"
      (type "copper")
      (thickness 0.0175)
    )
    (layer "dielectric 3"
      (type "prepreg")
      (thickness 0.2)
      (material "Isola 370HR")
      (epsilon_r 4.2)
      (loss_tangent 0.02)
    )
    (layer "B.Cu"
      (type "copper")
      (thickness 0.035)
    )
    (layer "B.Mask"
      (type "Bottom Solder Mask")
      (thickness 0.01)
    )
    (layer "B.Paste"
      (type "Bottom Solder Paste")
    )
    (layer "B.SilkS"
      (type "Bottom Silk Screen")
    )
    (copper_finish "ENIG")
    (dielectric_constraints no)
    (edge_connector none)
    (castellated_pads no)
    (edge_plating no)
  )

  ;; ============================================================
  ;; Board outline  100mm x 80mm on Edge.Cuts
  ;; Origin at (0,0), board extent (100, 80)
  ;; ============================================================
  (gr_rect
    (start 0 0)
    (end 100 80)
    (layer "Edge.Cuts")
    (width 0.05)
    (fill no)
    (uuid "edge-cuts-outline")
  )

  ;; ============================================================
  ;; Board title text on F.Fab
  ;; ============================================================
  (gr_text "Hello Demo Evaluation Board  v0.1  100x80mm  4L FR4  ENIG"
    (at 5 3 0)
    (layer "F.Fab")
    (effects (font (size 1.5 1.5) (thickness 0.15)))
    (uuid "fab-title-text")
  )
  (gr_text "OpenPhone  2026-05-17  RISC-V SoC eval  DO NOT FABRICATE WITHOUT DRC SIGN-OFF"
    (at 5 5.5 0)
    (layer "F.Fab")
    (effects (font (size 1.2 1.2) (thickness 0.12)))
    (uuid "fab-warn-text")
  )

  ;; Copper layer labels (Eco layer)
  (gr_text "L1: F.Cu (signal)"
    (at 5 74 0)
    (layer "Cmts.User")
    (effects (font (size 1.0 1.0) (thickness 0.1)))
    (uuid "lbl-l1")
  )
  (gr_text "L2: In1.Cu (GND solid pour)"
    (at 5 75.5 0)
    (layer "Cmts.User")
    (effects (font (size 1.0 1.0) (thickness 0.1)))
    (uuid "lbl-l2")
  )
  (gr_text "L3: In2.Cu (PWR split: VDDCORE / VDD_3V3 / VDD_1V8)"
    (at 5 77 0)
    (layer "Cmts.User")
    (effects (font (size 1.0 1.0) (thickness 0.1)))
    (uuid "lbl-l3")
  )
  (gr_text "L4: B.Cu (signal)"
    (at 5 78.5 0)
    (layer "Cmts.User")
    (effects (font (size 1.0 1.0) (thickness 0.1)))
    (uuid "lbl-l4")
  )

  ;; ============================================================
  ;; Mounting holes  M3  (3.2mm drill)  at 4 corners
  ;; 3mm from each edge
  ;; ============================================================
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 3.5 3.5)
    (uuid "mh1-topleft")
    (property "Reference" "MH1" (at 0 -4.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M3" (at 0 4.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask")
      (uuid "mh1-pad"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 96.5 3.5)
    (uuid "mh2-topright")
    (property "Reference" "MH2" (at 0 -4.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M3" (at 0 4.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask")
      (uuid "mh2-pad"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 3.5 76.5)
    (uuid "mh3-botleft")
    (property "Reference" "MH3" (at 0 -4.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M3" (at 0 4.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask")
      (uuid "mh3-pad"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 96.5 76.5)
    (uuid "mh4-botright")
    (property "Reference" "MH4" (at 0 -4.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "MountingHole_M3" (at 0 4.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask")
      (uuid "mh4-pad"))
  )

  ;; ============================================================
  ;; J3 - USB-C connector  (left edge, bottom half)
  ;; Approximate placement; footprint body extends to board edge
  ;; ============================================================
  (footprint "Connector_USB:GCT_USB4135-GF-A_Vertical"
    (layer "F.Cu")
    (at 8 65)
    (uuid "fp-j3-usbc")
    (property "Reference" "J3" (at 0 -8 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "USB4135-GF-A" (at 0 8 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (property "Footprint" "Connector_USB:GCT_USB4135-GF-A_Vertical" (at 0 0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15)) hide))
    (property "Datasheet" "https://gct.co/files/drawings/usb4135.pdf" (at 0 0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15)) hide))
    ;; Pads are placeholder - real footprint pads come from library
    (pad "A4" smd rect (at -1.6 -3.25) (size 0.6 1.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 23 "VBUS_RAW") (uuid "j3-vbus-a4"))
    (pad "A1" smd rect (at 1.6 -3.25) (size 0.6 1.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND") (uuid "j3-gnd-a1"))
    (pad "A5" smd rect (at -2.4 -3.25) (size 0.6 1.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0 "") (uuid "j3-cc1-a5"))
    (pad "B5" smd rect (at 2.4 -3.25) (size 0.6 1.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0 "") (uuid "j3-cc2-b5"))
    (pad "S1" thru_hole circle (at -3.5 0) (size 2.4 2.4) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "GND") (uuid "j3-shield1"))
    (pad "S2" thru_hole circle (at 3.5 0) (size 2.4 2.4) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "GND") (uuid "j3-shield2"))
  )

  ;; ============================================================
  ;; J1 - Samtec FTSH-105 debug header  (right edge, top)
  ;; ============================================================
  (footprint "Connector_Samtec_FTSH:Samtec_FTSH-105-01-F-DV-K_2x05_P1.27mm_Vertical"
    (layer "F.Cu")
    (at 90 10)
    (uuid "fp-j1-debug")
    (property "Reference" "J1" (at 0 -6 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "FTSH-105-01-F-DV-K" (at 0 6 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    ;; 10-pin 1.27mm dual row: pins 1-9 odd col, 2-10 even col
    (pad "1"  smd rect (at -0.635 -2.54)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "VDD_1V8")  (uuid "j1-p1"))
    (pad "2"  smd rect (at  0.635 -2.54)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 9 "JTAG_TMS") (uuid "j1-p2"))
    (pad "3"  smd rect (at -0.635 -1.27)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")      (uuid "j1-p3"))
    (pad "4"  smd rect (at  0.635 -1.27)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 8 "JTAG_TCK") (uuid "j1-p4"))
    (pad "5"  smd rect (at -0.635  0)     (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")      (uuid "j1-p5"))
    (pad "6"  smd rect (at  0.635  0)     (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 11 "JTAG_TDO")(uuid "j1-p6"))
    (pad "7"  smd rect (at -0.635  1.27)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 0 "")         (uuid "j1-p7"))
    (pad "8"  smd rect (at  0.635  1.27)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 10 "JTAG_TDI")(uuid "j1-p8"))
    (pad "9"  smd rect (at -0.635  2.54)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND")      (uuid "j1-p9"))
    (pad "10" smd rect (at  0.635  2.54)  (size 0.76 1.27) (layers "F.Cu" "F.Paste" "F.Mask") (net 7 "nRST")     (uuid "j1-p10"))
  )

  ;; ============================================================
  ;; U1 - hello_chip  QFN64 9x9mm+EP  (center of board)
  ;; ============================================================
  (footprint "Package_DFN_QFN:QFN-64-1EP_9x9mm_P0.5mm_EP6.5x6.5mm"
    (layer "F.Cu")
    (at 50 40)
    (uuid "fp-u1-soc")
    (property "Reference" "U1" (at 0 -8 0) (layer "F.SilkS") (effects (font (size 1.2 1.2) (thickness 0.15))))
    (property "Value" "hello_chip_v0" (at 0 8 0) (layer "F.Fab") (effects (font (size 1.2 1.2) (thickness 0.15))))
    (property "Footprint" "Package_DFN_QFN:QFN-64-1EP_9x9mm_P0.5mm_EP6.5x6.5mm" (at 0 0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15)) hide))
    ;; Thermal pad (EP) connected to GND
    (pad "65" smd rect (at 0 0) (size 6.5 6.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND") (uuid "u1-ep"))
    ;; CLK_IN (pin 1 assumed on side 1, position varies with actual pinout)
    ;; RST_N (pin 2), etc. — exact pin assignment needs package vendor drawing
    ;; Placeholder pads for CLK_IN and RST_N
    (pad "1"  smd rect (at -4.75  3.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 6  "CLK_24M")  (uuid "u1-p1"))
    (pad "2"  smd rect (at -4.75  3.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 7  "nRST")     (uuid "u1-p2"))
    (pad "3"  smd rect (at -4.75  2.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 9  "JTAG_TMS") (uuid "u1-p3"))
    (pad "4"  smd rect (at -4.75  2.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 8  "JTAG_TCK") (uuid "u1-p4"))
    (pad "5"  smd rect (at -4.75  1.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 10 "JTAG_TDI") (uuid "u1-p5"))
    (pad "6"  smd rect (at -4.75  1.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 11 "JTAG_TDO") (uuid "u1-p6"))
    (pad "7"  smd rect (at -4.75  0.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 12 "UART_TX")  (uuid "u1-p7"))
    (pad "8"  smd rect (at -4.75  0.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 13 "UART_RX")  (uuid "u1-p8"))
    (pad "9"  smd rect (at -4.75 -0.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 14 "GPIO0")    (uuid "u1-p9"))
    (pad "10" smd rect (at -4.75 -0.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 15 "GPIO1")    (uuid "u1-p10"))
    (pad "11" smd rect (at -4.75 -1.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 16 "GPIO2")    (uuid "u1-p11"))
    (pad "12" smd rect (at -4.75 -1.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 17 "GPIO3")    (uuid "u1-p12"))
    (pad "13" smd rect (at -4.75 -2.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 18 "IRQ_TIMER")(uuid "u1-p13"))
    (pad "14" smd rect (at -4.75 -2.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 19 "IRQ_DMA")  (uuid "u1-p14"))
    (pad "15" smd rect (at -4.75 -3.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 20 "BOOT_SEL") (uuid "u1-p15"))
    (pad "16" smd rect (at -4.75 -3.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 3  "VDD_CORE") (uuid "u1-p16"))
    ;; VDD_CORE pads (multiple)
    (pad "17" smd rect (at -3.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 3  "VDD_CORE") (uuid "u1-p17"))
    (pad "18" smd rect (at -3.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 1  "GND")      (uuid "u1-p18"))
    (pad "19" smd rect (at -2.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 4  "VDD_3V3")  (uuid "u1-p19"))
    (pad "20" smd rect (at -2.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 5  "VDD_1V8")  (uuid "u1-p20"))
    (pad "21" smd rect (at -1.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 1  "GND")      (uuid "u1-p21"))
    (pad "22" smd rect (at -1.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 1  "GND")      (uuid "u1-p22"))
    (pad "23" smd rect (at -0.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p23"))
    (pad "24" smd rect (at -0.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p24"))
    (pad "25" smd rect (at  0.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p25"))
    (pad "26" smd rect (at  0.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p26"))
    (pad "27" smd rect (at  1.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p27"))
    (pad "28" smd rect (at  1.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p28"))
    (pad "29" smd rect (at  2.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p29"))
    (pad "30" smd rect (at  2.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p30"))
    (pad "31" smd rect (at  3.25 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p31"))
    (pad "32" smd rect (at  3.75 -4.75) (size 0.8 0.25) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p32"))
    ;; Right side
    (pad "33" smd rect (at  4.75  3.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p33"))
    (pad "34" smd rect (at  4.75  3.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p34"))
    (pad "35" smd rect (at  4.75  2.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p35"))
    (pad "36" smd rect (at  4.75  2.25) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p36"))
    (pad "37" smd rect (at  4.75  1.75) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0  "")         (uuid "u1-p37"))
