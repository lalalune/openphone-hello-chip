        },
        {
          "artifact": "U-Boot OpenSBI boot-chain transcript",
          "path": "docs/evidence/linux/u_boot_opensbi_boot_chain.log",
          "capture_command": "OPENPHONE_UBOOT_BOOT_CMD='/path/to/qemu-or-renode boot command' sw/u-boot/capture-u-boot-evidence.sh /path/to/u-boot boot-chain",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=u-boot artifact=u_boot_opensbi_boot_chain",
            "openphone-evidence: command=",
            "OpenSBI",
            "U-Boot",
            "openphone-evidence: status=PASS"
          ]
        }
      ]
    },
    "aosp": {
      "evidence": [
        {
          "artifact": "AOSP lunch transcript",
          "path": "docs/evidence/android/openphone_ai_soc_lunch.log",
          "capture_command": "sw/aosp-device/capture-aosp-evidence.sh /path/to/aosp lunch",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=aosp artifact=openphone_ai_soc_lunch",
            "openphone-evidence: command=lunch openphone_ai_soc-userdebug",
            "openphone_ai_soc-userdebug",
            "TARGET_PRODUCT=openphone_ai_soc",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "AOSP vendorimage transcript",
          "path": "docs/evidence/android/openphone_ai_soc_vendorimage.log",
          "capture_command": "sw/aosp-device/capture-aosp-evidence.sh /path/to/aosp vendorimage",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=aosp artifact=openphone_ai_soc_vendorimage",
            "openphone-evidence: command=m vendorimage",
            "vendor.img",
            "installed-files-vendor.txt",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "AOSP VINTF transcript",
          "path": "docs/evidence/android/openphone_ai_soc_checkvintf.log",
          "capture_command": "sw/aosp-device/capture-aosp-evidence.sh /path/to/aosp checkvintf",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=aosp artifact=openphone_ai_soc_checkvintf",
            "openphone-evidence: command=",
            "checkvintf",
            "openphone_ai_soc",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "AOSP Cuttlefish riscv64 boot transcript",
          "path": "docs/evidence/android/cuttlefish_riscv64_boot.log",
          "capture_command": "sw/aosp-device/capture-aosp-evidence.sh /path/to/aosp cuttlefish-boot",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=aosp artifact=cuttlefish_riscv64_boot",
            "openphone-evidence: command=",
            "launch_cvd",
            "adb shell",
            "ro.product.cpu.abi=riscv64",
