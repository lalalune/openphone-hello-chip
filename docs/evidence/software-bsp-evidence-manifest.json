{
  "schema_version": 1,
  "claim_boundary": "external_transcripts_only",
  "targets": {
    "buildroot": {
      "evidence": [
        {
          "artifact": "Buildroot defconfig transcript",
          "path": "docs/evidence/buildroot/openphone_hello_defconfig.log",
          "capture_command": "sw/buildroot/scripts/capture-buildroot-evidence.sh /path/to/buildroot defconfig",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=buildroot artifact=openphone_hello_defconfig",
            "openphone-evidence: command=make BR2_EXTERNAL=",
            "openphone_hello_defconfig",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "Buildroot image manifest",
          "path": "docs/evidence/buildroot/openphone_hello_image_manifest.txt",
          "capture_command": "sw/buildroot/scripts/capture-buildroot-evidence.sh /path/to/buildroot image-manifest",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=buildroot artifact=openphone_hello_image_manifest",
            "openphone-evidence: command=find output/images",
            "output/images",
            "sha256",
            "openphone-evidence: status=PASS"
          ],
          "at_least_one": [
            ["Image", "vmlinux", "rootfs"]
          ]
        },
        {
          "artifact": "Buildroot runtime MMIO smoke",
          "path": "docs/evidence/buildroot/hello-mmio-smoke.log",
          "capture_command": "HELLO_SMOKE_CMD='ssh root@TARGET /usr/bin/hello-mmio-smoke' sw/buildroot/scripts/capture-buildroot-evidence.sh /path/to/buildroot smoke",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=buildroot artifact=hello-mmio-smoke",
            "openphone-evidence: command=",
            "hello-mmio-smoke",
            "/dev/hello-npu",
            "openphone-evidence: status=PASS"
          ]
        }
      ]
    },
    "linux": {
      "evidence": [
        {
          "artifact": "Linux kernel build transcript",
          "path": "docs/evidence/linux/openphone_hello_kernel_build.log",
          "capture_command": "sw/linux/scripts/capture-linux-bsp-evidence.sh /path/to/linux kernel-build",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=linux artifact=openphone_hello_kernel_build",
            "openphone-evidence: command=make ARCH=riscv",
            "CONFIG_OPENPHONE_HELLO",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "Linux DTB validation transcript",
          "path": "docs/evidence/linux/openphone_hello_dtb_check.log",
          "capture_command": "sw/linux/scripts/capture-linux-bsp-evidence.sh /path/to/linux dtb-check",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=linux artifact=openphone_hello_dtb_check",
            "openphone-evidence: command=make ARCH=riscv",
            "openphone-hello",
            "openphone,hello-npu",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "Linux runtime MMIO smoke",
          "path": "docs/evidence/linux/hello-mmio-smoke.log",
          "capture_command": "HELLO_SMOKE_CMD='ssh root@TARGET /tmp/hello-mmio-smoke' sw/linux/scripts/capture-linux-bsp-evidence.sh /path/to/linux smoke",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=linux artifact=hello-mmio-smoke",
            "openphone-evidence: command=",
            "HELLO_NPU_BASE=0x10020000",
            "/dev/hello-npu",
            "openphone-evidence: status=PASS"
          ]
        }
      ]
    },
    "opensbi": {
      "evidence": [
        {
          "artifact": "OpenSBI OpenPhone build transcript",
          "path": "docs/evidence/linux/opensbi_openphone_build.log",
          "capture_command": "OPENPHONE_OPENSBI_CMD='make PLATFORM=generic FW_DYNAMIC=y' sw/opensbi/capture-opensbi-evidence.sh /path/to/opensbi build",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=opensbi artifact=opensbi_openphone_build",
            "openphone-evidence: command=",
            "OpenSBI",
            "fw_dynamic",
            "openphone-evidence: status=PASS"
          ]
        },
        {
          "artifact": "OpenSBI fw_dynamic handoff transcript",
          "path": "docs/evidence/linux/opensbi_fw_dynamic_handoff.log",
          "capture_command": "OPENPHONE_OPENSBI_HANDOFF_CMD='/path/to/qemu-or-renode boot command' sw/opensbi/capture-opensbi-evidence.sh /path/to/opensbi handoff",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=opensbi artifact=opensbi_fw_dynamic_handoff",
            "openphone-evidence: command=",
