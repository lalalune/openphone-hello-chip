        {
          "artifact": "Android CTS virtual-device subset transcript",
          "path": "docs/evidence/android/cts_virtual_device_subset.log",
          "capture_command": "sw/aosp-device/capture-aosp-evidence.sh /path/to/aosp cts-subset",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=aosp artifact=cts_virtual_device_subset",
            "openphone-evidence: compatibility_scope=virtual_device_subset",
            "openphone-evidence: command=",
            "cts-tradefed",
            "openphone-evidence: status=PASS"
          ],
          "forbidden_strings": [
            "CDD compliant",
            "full CTS pass",
            "full VTS pass",
            "Android compatible"
          ]
        },
        {
          "artifact": "Android VTS virtual-device subset transcript",
          "path": "docs/evidence/android/vts_virtual_device_subset.log",
          "capture_command": "sw/aosp-device/capture-aosp-evidence.sh /path/to/aosp vts-subset",
          "min_bytes": 160,
          "required_strings": [
            "openphone-evidence: target=aosp artifact=vts_virtual_device_subset",
            "openphone-evidence: compatibility_scope=virtual_device_subset",
            "openphone-evidence: command=",
            "vts-tradefed",
            "openphone-evidence: status=PASS"
